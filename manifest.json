{
  "id": "reading-log",
  "name": "Reading Log",
  "version": "1.1.0",
  "description": "Children log books they've read with ratings and notes. Adults see a summary across the whole family.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "kids",
  "tags": ["reading", "kids", "education"],
  "storage": "db",
  "db_encryption": "off",
  "contexts": ["household", "shared_space", "shared_space.roster"],
  "data_access": {
    "reads": ["family.members"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["books_summary", "reading_stats"]
  },
    "member_references": {
      "books": {
        "column": "member_id",
        "on_removed": "delete"
      }
    },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS value FROM app_reading_log__books WHERE member_id = :me AND finished_at <> '' AND finished_at >= substr(:today, 1, 4) || '-01-01' LIMIT 1"
    },
    "display": {
      "template": "stat",
      "value": "value",
      "label": "books finished this year",
      "empty_hides": true
    }
  },
  "row_policies": {
    "books": {
      "kind": "owner_only",
      "member_column": "member_id",
      "adults_bypass": true
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "nav": { "label": "Reading Log" },
  "icon": "📚"
}
